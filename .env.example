# Database Configuration
# Replace with your local PostgreSQL credentials or cloud database connection string
DB_CONNECTION="Host=localhost;Database=airport_admin;Username=postgres;Password=your_local_password"

# JWT Authentication
# Generate a strong, random string for local development
JWT_SECRET="your_local_super_secret_key_minimum_32_characters_long"
JWT_EXPIRY_HOURS=24

# CORS Settings
# Comma-separated list of allowed origins (e.g., your local frontend and production frontend)
Cors__AllowedOrigins="http://localhost:5173"